# Maintainer: Cibitka (https://github.com/Cibitka)
pkgname=cibitube-bin
pkgver=0.2.10
pkgrel=1
pkgdesc='Native YouTube Music player with lyrics, playlists and downloads'
arch=('x86_64')
url='https://github.com/Cibitka/Cibitube'
license=('MIT')
depends=(
  'gcc-libs'
  'glibc'
  'libssl.so=3-64'
  'libcrypto.so=3-64'
  'libglvnd'
  'libx11'
  'libxcursor'
  'libxi'
  'libxrandr'
  'libxkbcommon'
  'wayland'
  'mpv'
  'yt-dlp'
  'ffmpeg'
  'nodejs'
)
optdepends=(
  'sqlite: import a YouTube Music session from Firefox'
  'zenity: graphical file picker'
  'xdg-utils: open browser links and folders'
  'ttf-dejavu: additional interface glyphs'
  'noto-fonts-cjk: display CJK song titles and lyrics'
)
provides=('cibitube')
conflicts=('cibitube')
options=('!strip' '!debug')
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/Cibitka/Cibitube/releases/download/v${pkgver}/cibitube-linux-x86_64.tar.gz"
  "LICENSE-${pkgver}::https://raw.githubusercontent.com/Cibitka/Cibitube/v${pkgver}/LICENSE"
  "cibitube-${pkgver}.png::https://raw.githubusercontent.com/Cibitka/Cibitube/v${pkgver}/assets/icon.png"
  'cibitube.desktop'
)
sha256sums=(
  '9ee2f9d6ec4845012b644b145ff0e2a950d0fc948f07b209bc379a242ef37779'
  '7671d745b52e6aca21ea799d389910d22a448c7730e72ea924ae318f2d8a5722'
  'c61185543321cd0fc671fa5bdb4d80709292e0a7114c6ea8993370318a6f2875'
  '11a62aff39733bd2b4a5e14e2371cdc52034dc6bcb0485e7c31fee57daf1a2eb'
)

package() {
  install -Dm755 cibitube "${pkgdir}/usr/bin/cibitube"
  install -Dm644 cibitube.desktop "${pkgdir}/usr/share/applications/cibitube.desktop"
  install -Dm644 "cibitube-${pkgver}.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/cibitube.png"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -dm755 "${pkgdir}/usr/share/cibitube"
  printf '%s\n' pacman > "${pkgdir}/usr/share/cibitube/package-manager"
}
